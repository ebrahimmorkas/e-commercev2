NODE_ENV=
PORT=

# Mongodb
MONGODB_URI=

# Redis
REDIS_URL=
REDIS_PASSWORD=
IS_REDIS_SERVER_ON=

# JWT Auth
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_HASH_SECRET= 
ACCESS_TOKEN_EXPIRY=
REFRESH_TOKEN_EXPIRY=

# bCRYPT
SALT_ROUNDS=

# Images
ALLOWED_IMAGE_TYPES_FOR_IMAGES=/jpg|jpeg|png|gif/

#cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Storage Provider
STORAGE_PROVIDER=

# Email - nodemailer (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Email - sendgrid
SENDGRID_API_KEY=

# Email - ses (falls back to AWS_REGION above if AWS_SES_REGION is unset)
AWS_SES_REGION=

# Encryption and Decryption
ID_ENCRYPTION_KEY=abcdefghijklmnopqrstuvwxy
ID_ENCRYPTION_IV=a1b2c3d4be

# Used to encrypt vendor payment gateway credentials (server key/client key)
# at rest - 64 hex chars (32 bytes). See encryptSecret/decryptSecret in
# utils/common.js. If unset, a random key is generated per process start,
# which means every previously-saved credential becomes undecryptable on
# restart/redeploy - set this before storing any real vendor credentials.
CREDENTIALS_ENCRYPTION_KEY=

# Payment Gateway - PayTabs. Each vendor has their OWN PayTabs merchant
# account/credentials (entered via
# scripts/manageVendorPaymentGatewayCredentials.js, stored encrypted in
# VendorPaymentGatewayCredentials) - not a shared platform-wide account.
# This is only the fallback API host used when a vendor's own record doesn't
# specify its own baseUrl. See config/paymentGatewayConfig.js.
PAYTABS_BASE_URL=https://secure.paytabs.com

# Path (on the vendor's own domain) the customer is redirected back to after
# a hosted-page payment attempt, e.g. https://<vendor-domain><this path>?orderId=...
# Needs a matching frontend route.
PAYMENT_RETURN_PATH=/checkout/payment-result