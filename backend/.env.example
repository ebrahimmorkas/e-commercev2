NODE_ENV=
PORT=

# Mongodb
MONGODB_URI=

# Live hosting only. The backend is reached through the frontend host's /api
# rewrite, and the vendor is found from the forwarded storefront domain. If a
# request still arrives on the backend's own address (RENDER_EXTERNAL_HOSTNAME,
# set by Render itself), this vendor domain is used instead - see
# middlewares/vendorDetection.js. Leave empty in local development.
DEFAULT_VENDOR_DOMAIN=

# On Render the server pings its own /healthz every 10 minutes so the free
# plan never puts it to sleep (services/keepAliveService.js). Set to 0 to turn
# that off. Has no effect anywhere else.
KEEP_ALIVE_ENABLED=

# Other origins allowed to call this API from a browser (comma separated, e.g.
# https://shop.example.com). Normally empty: the frontend calls the API on its
# own origin (Vite proxy in development, /api rewrite when live).
CORS_ALLOWED_ORIGINS=

# Redis
REDIS_URL=
REDIS_PASSWORD=
IS_REDIS_SERVER_ON=

# Cookie signing (used for the long-lived knownUserId abandoned-cart hint cookie - see cookieOptions.js)
COOKIE_SECRET=

# JWT Auth
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_HASH_SECRET= 
ACCESS_TOKEN_EXPIRY=
REFRESH_TOKEN_EXPIRY=

# bCRYPT
SALT_ROUNDS=

# Images
ALLOWED_IMAGE_TYPES_FOR_IMAGES=/jpg|jpeg|png|gif/

#cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Storage Provider
STORAGE_PROVIDER=

# Email - nodemailer (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Email - sendgrid
SENDGRID_API_KEY=

# Email - ses (falls back to AWS_REGION above if AWS_SES_REGION is unset)
AWS_SES_REGION=

# Encryption and Decryption - used to reversibly encode ObjectIds (see
# encodeId/decodeId in utils/common.js) so raw Mongo _ids never appear in
# API requests/responses. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# ID_ENCRYPTION_KEY must be exactly 64 hex chars (32 bytes), ID_ENCRYPTION_IV
# exactly 32 hex chars (16 bytes) - createCipheriv throws otherwise. If unset,
# a random key/IV is generated per process start, which means every encoded
# id becomes undecryptable on restart/redeploy.
ID_ENCRYPTION_KEY=
ID_ENCRYPTION_IV=

# Used to encrypt vendor payment gateway credentials (server key/client key)
# at rest - 64 hex chars (32 bytes). See encryptSecret/decryptSecret in
# utils/common.js. If unset, a random key is generated per process start,
# which means every previously-saved credential becomes undecryptable on
# restart/redeploy - set this before storing any real vendor credentials.
CREDENTIALS_ENCRYPTION_KEY=

# Payment Gateways - every vendor has their OWN gateway account/credentials
# (entered via scripts/manageVendorPaymentGatewayCredentials.js, stored
# encrypted in VendorPaymentGatewayCredentials) - not a shared platform-wide
# account. See backend/docs/payment-gateways.md for the full setup guide.

# PayTabs - this is only the fallback API host used when a vendor's own
# record doesn't specify its own baseUrl (their account's region can differ
# from vendor to vendor). See config/paymentGatewayConfig.js.
PAYTABS_BASE_URL=https://secure.paytabs.com

# Stripe - no env vars needed here. Stripe has one single, fixed API host
# (https://api.stripe.com, hardcoded in config/paymentGatewayConfig.js) and
# every vendor's secret/publishable key is entered per-vendor via the script
# above, same as PayTabs.

# Path (on the vendor's own domain) the customer is redirected back to after
# a hosted-page payment attempt, e.g. https://<vendor-domain><this path>?orderId=...
# Needs a matching frontend route.
PAYMENT_RETURN_PATH=/checkout/payment-result
# Exchange rates (storefront currency conversion - services/exchangeRateService.js).
# Optional: default provider is ExchangeRate-API, whose free open endpoint needs no key.
EXCHANGE_RATE_PROVIDER=exchangerate-api
# Set only if you buy an ExchangeRate-API plan (uses the keyed v6 endpoint instead).
EXCHANGE_RATE_API_KEY=
