const mongoose = require('mongoose');

const companyMasterSchema = mongoose.Schema({
    vendorId: {
        type: mongoose.Types.ObjectId,
        required: true,
        unique: true,
        index: true
    },
    isSendingEmailFeatureOn: {
        type: Boolean,
        default: false
    },
    isEmailVerificationFeatureOn: {
        type: Boolean,
        default: false
    },
    isSendingSMSFeatureOn: {
        type: Boolean,
        default: false
    },
    isMobileVerificationFeatureOn: {
        type: Boolean,
        default: false
    },
    fileUploadSize: {
        type: Number,
        default: 5
    },
    isPDFDownloadableFeatureOn: {
        type: Boolean,
        default: true
    },
    isAnnouncementFeatureOn: {
        type: Boolean,
        default: true
    },
    numberOfAnnouncementsAllowed: {
        type: Number,
        default: 2,
    },
    isBannerFeatureOn: {
        type: Boolean,
        default: true
    },
    numberOfBannersAllowed: {
        type: Number,
        default: 2
    },
    allowedBannerImagesMB: {
        type: Number,
        default: 2
    },
    allowedBannerImagesFormat: {
        type: String,
        enum: ['jpg', 'png', 'jpeg']
    },
    isBulkUploadForFeatureOn: {
        type: Boolean,
    },
    isWebsiteBuilderFeatureOn: {
        type: Boolean,
        default: false
    },
    status: {
        type: String,
        enum: ['I', 'A', 'D'],
        default: 'A',
        required: true
    },
    allowedCountries: {
        type: [mongoose.Schema.Types.ObjectId],
        ref: "CountryMaster",
        default: []
    },

    // Categories
    numberOfMainCategoriesAllowed: {
        type: Number,
        default: null
    },
    numberOfSubcategoriesAllowed: {
        type: Number,
        default: null
    },
    isTaggingChildrenCategoryAllowed: {
        type: Boolean,
        default: true,
    },
    allowedCategoryImageMB: {
        type: Number,
        default: 2
    },
    allowedCategoryImagesFormat: {
        type: [String],
        enum: ['jpg', 'png', 'jpeg']
    },
    isCategoryFeatureOn: {
        type: Boolean,
        default: true
    },
    isBulkUploadForCategoriesFeatureOn: {
        type: Boolean,
    },

    // Image
    imageService: {
        type: String,
        enum: ['cloudinary', 'aws', 'r2', 'local'],
        default: 'cloudinary'
    },

    // Email
    // Which provider this vendor was assigned (based on what they paid for).
    // Overridden site-wide whenever WebsiteMaster.mainEmailService is set -
    // see resolveEmailProvider in emailService.js.
    emailService: {
        type: String,
        enum: ['nodemailer', 'sendgrid', 'ses'],
        default: null
    },
    // Lifetime cap - never resets, always enforced once set. null = no
    // lifetime cap.
    numberOfEmailsAllowed: {
        type: Number,
        default: null
    },
    // Optional extra throttle within the lifetime budget above, resets every
    // calendar month. null = no monthly throttle (only the lifetime cap
    // applies).
    numberOfEmailsAllowedPerMonth: {
        type: Number,
        default: null
    },
    // End of Email

    // Email Template
    // Gates the EmailTemplateMaster CRUD specifically. The rest of the
    // fields in this section are NOT tied to templates - see the matching
    // comment in WebsiteMaster.js.
    isEmailTemplateFeatureOn: {
        type: Boolean,
        default: false
    },
    numberOfTemplatesAllowed: {
        type: Number,
        default: 5
    },
    numberOfAttachmentsAllowed: {
        type: Number,
        default: 3
    },
    numberOfImageAllowed: {
        type: Number,
        default: 3
    },
    // MB, per attachment
    attachmentSizeAllowed: {
        type: Number,
        default: 5
    },
    // MB, per image
    imageSizeAllowed: {
        type: Number,
        default: 2
    },
    isAddingOfAttachmentAllowed: {
        type: Boolean,
        default: true
    },
    isAddingOfImageAllowed: {
        type: Boolean,
        default: true
    },
    allowedAttachmentExtensions: {
        type: [String],
        default: ['pdf', 'doc', 'docx', 'xlsx', 'png', 'jpg', 'jpeg']
    },
    allowedImageExtensions: {
        type: [String],
        default: ['jpg', 'jpeg', 'png']
    },
    isCcAndBccFeatureOn: {
        type: Boolean,
        default: true
    },
    isControlSelectionFeatureOn: {
        type: Boolean,
        default: true
    },
    isEmbeddingLinksAllowed: {
        type: Boolean,
        default: true
    },
    // End of Email Template

        // Discount
    isDiscountFeatureOn: {
        type: Boolean,
        default: false
    },
    numberOfDiscountsPerMonth: {
        type: Number,
        default: 3
    },
    // Restricts which giveDiscountTo options (GIVE_DISCOUNT_TO_CONFIG keys in
    // discountConstants.js) this vendor may use. Empty array = all allowed.
    allowedConstantsOfGiveDiscountTo: {
        type: [String],
        enum: [
            'ALL_PRODUCTS_ALL_USERS',
            'SPECIFIC_PRODUCTS_ALL_USERS',
            'SPECIFIC_CATEGORIES_ALL_USERS',
            'PRODUCT_GROUP_ALL_USERS',
            'CATEGORY_GROUP_ALL_USERS',
            'USER_GROUP',
            'ALL_PRODUCTS_SPECIFIC_USERS',
            'SPECIFIC_PRODUCTS_SPECIFIC_USERS',
            'SPECIFIC_CATEGORIES_SPECIFIC_USERS',
            'CATEGORY_GROUP_SPECIFIC_USERS',
            'PRODUCT_GROUP_SPECIFIC_USERS',
            'PRODUCT_VARIANTS_SPECIFIC_USERS',
            'PRODUCT_VARIANTS_ALL_USERS'
        ],
        default: []
    },
    // Restricts which discount "types" (Ongoing, Minimum Quantity, Coupon
    // Code, Scheduled, Specific Days, Specific Days + Hours, Payment Method)
    // this vendor may use. Empty array = all allowed.
    allowedDiscountFeatureTypes: {
        type: [String],
        enum: [
            'ONGOING_DISCOUNT',
            'MINIMUM_QUANTITY_DISCOUNT',
            'COUPON_CODE_DISCOUNT',
            'SCHEDULED_DISCOUNT',
            'SPECIFIC_DAYS_DISCOUNT',
            'SPECIFIC_DAYS_HOURS_DISCOUNT',
            'PAYMENT_METHOD_DISCOUNT'
        ],
        default: []
    },
    // Restricts which discountType values (FIXED_PRICE / PERCENTAGE) this
    // vendor may use. Empty array = all allowed.
    allowedDiscountTypes: {
        type: [String],
        enum: ['FIXED_PRICE', 'PERCENTAGE'],
        default: []
    },
    // End of Discount

    // Return / Exchange
    isReturnFeatureOn: {
        type: Boolean,
        default: false
    },
    isExchangeFeatureOn: {
        type: Boolean,
        default: false
    },
    // End of Return / Exchange

    // Product
    numberOfProductsAllowed: {
        type: Number,
    },
    numberOfProductsVaiantsAllowed: {
        type: Number
    },
    numberOfAdditionalImagesAllowedInVariant: {
        type: Number
    },
    allowedSizes: {
        type: [mongoose.Schema.Types.ObjectId],
        ref: "SizeMaster",
        default: []
    },
    allowedProductImageMB: {
        type: Number,
        default: 2
    },
    allowedProductImagesFormat: {
        type: String,
        enum: ['jpg', 'png', 'jpeg']
    },
    // Vendor wil be able to add only Main Category if this is false
    isCategoryNestingAllowed: {
        type: Boolean,    
        default: true
    },
    isBulkPricingFeatureOn: {
        type: Boolean,
        default: true
    },
    isBulkUploadForProductsFeatureOn: {
        type: Boolean,
        default: true
    },

    // Brand
    isBrandFeatureOn: {
        type: Boolean,
        default: true
    },
    numberOfBrandsAllowed: {
        type: Number,
        default: 10
    },
    // End of Brand

    // Groups
    isGroupFeatureOn: {
        type: Boolean,
    },
    numberOfGroupsAllowed: {
        type: Number,
        default: 6
    },
    numberOfMembersPerGroup: {
        type: Number,
        default: 50
    },

    // Review
    isReviewFeatureOn: {
        type: Boolean,
        default: false
    },
    numberOfReviewsAllowedOnProduct: {
        type: Number,
        default: null
    },

    // Cart
    isCartFeatureOn: {
        type: Boolean,
        default: true
    },
    numberOfProductsAllowedInCartAtOnce: {
        type: Number,
        default: 1000
    },

    // Order
    numberOfOrdersAllowed: {
        type: Number,
        default: 10000
    },
    orderSteps: {
        type: mongoose.Schema.Types.ObjectId,
        ref: "OrderStepMaster",
        default: null,
        index: true
    },
    isOrderTrakingAllowed: {
        type: Boolean,
        default: false
    },
    isOrderStatusUpdationAllowedByDeliveryAgents: {
        type: Boolean,
        default: false
    },
    isEmailSendingFeatureOnAfterOrderStatusChanges: {
        type: Boolean,
        default: false
    },
    numberOfOrdersAllowedPerMonth: {
        type: Number,
        default: 1000000
    }
}, {
  timestamps: true
});

module.exports = mongoose.model('CompanyMaster', companyMasterSchema);